# Get a development/personal key from https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-your-key-here

# Platform routing for ladder endpoints. Examples: na1, euw1, kr.
TFT_PLATFORM=na1

# Regional routing for TFT match history. NA/BR/LAN/LAS/OCE -> americas.
TFT_REGION=americas

# Local SQLite database. Used for local/demo development and tests, and as
# the production fallback when DATABASE_URL is unset or unreachable.
TFT_DB_PATH=data/tftlab.sqlite3

# Optional: a postgres://... or postgresql://... URL. When set and reachable
# with real match data, production uses it instead of SQLite. Never commit a
# real value here; set it in your host's environment/secret manager instead.
DATABASE_URL=
