# TheoryLabs settings. Copy this file to `.env` (or run `tftlab local-init`)
# and fill in your Riot key. `.env` is git-ignored: never commit it, and never
# paste the key into chat, issues or screenshots.

# Riot development key from https://developer.riotgames.com/ (it expires about
# every 24 hours; paste the new one here, or run `tftlab local-set-key`).
RIOT_API_KEY=RGAPI-your-key-here

# Platform routing for ladder endpoints. Examples: na1, euw1, kr.
TFT_PLATFORM=na1

# Regional routing for TFT match history. NA/BR/LAN/LAS/OCE -> americas.
TFT_REGION=americas

# --- Three different databases; do not mix them up -------------------------
#
# 1. LOCAL RAW COLLECTOR DATABASE (private, this computer only).
#    Written by `tftlab local-collect`, read by `local-status`/`local-snapshot`.
#    Holds raw Riot payloads and the player-sampling ledger, so it must never
#    be published. Default: data/local/theorylabs.sqlite3 (git-ignored).
#    The local-* commands never use DATABASE_URL and refuse database URLs.
# TFT_LOCAL_DB_PATH=data/local/theorylabs.sqlite3
#
# 2. PUBLIC SANITIZED SNAPSHOT (what the website may serve).
#    Made from (1) by `tftlab local-snapshot` into data/local/public/: no raw
#    payloads, no player ids, no collection ledger. Not configured here.
#
# 3. CLOUD DATABASE_URL (optional, not needed for local collection).
#    A postgres:// or postgresql:// URL used only by the generic commands
#    (ingest-riot, validate-live-data, ...) when set. Leave it empty for the
#    zero-cost local workflow. Never commit a real value.
DATABASE_URL=

# SQLite file the generic commands use when DATABASE_URL is empty (local
# development/demo; not the local collector database above).
TFT_DB_PATH=data/tftlab.sqlite3
